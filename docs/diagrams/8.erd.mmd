erDiagram
    USER ||--o| PASSENGER : "has profile"
    USER ||--o| STAFF : "has profile"
    USER {
        int id PK
        string email UK
        string password_hash
        enum role "ADMIN | STAFF | PASSENGER"
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    PASSENGER ||--o{ BOOKING : "makes"
    PASSENGER {
        int id PK
        int user_id FK "UK, nullable for companions"
        string first_name
        string last_name
        string phone
        date date_of_birth
        string passport_number
        string address
    }

    STAFF ||--o| USER : "linked to"
    STAFF {
        int id PK
        int user_id FK "UK"
        string staff_number UK
        string first_name
        string last_name
        string phone
        enum role "CHECK_IN_OFFICER"
        boolean is_active
    }

    AIRPORT ||--o{ ROUTE : "origin"
    AIRPORT ||--o{ ROUTE : "destination"
    AIRPORT {
        int id PK
        string iata_code UK
        string icao_code UK
        string name
        string city
        string country
        string timezone
        boolean is_active
    }

    ROUTE ||--o{ FLIGHT : "operates"
    ROUTE {
        int id PK
        int origin_airport_id FK
        int destination_airport_id FK
        int distance_km
        int estimated_duration_minutes
        boolean is_active
    }

    AIRCRAFT ||--o{ FLIGHT : "flies"
    AIRCRAFT ||--o{ SEAT : "contains"
    AIRCRAFT {
        int id PK
        string registration_number UK
        string manufacturer
        string model
        int seat_capacity
        enum status "ACTIVE | MAINTENANCE | RETIRED"
    }

    SEAT ||--o{ BOOKING : "reserved for"
    SEAT {
        int id PK
        int aircraft_id FK
        string seat_number
        enum seat_class "ECONOMY | BUSINESS"
        int row_number
        enum position "WINDOW | MIDDLE | AISLE"
    }

    FLIGHT ||--o{ BOOKING : "booked on"
    FLIGHT ||--o{ FLIGHT_STAFF : "assigned"
    FLIGHT {
        int id PK
        string flight_number UK
        int route_id FK
        int aircraft_id FK
        datetime departure_time
        datetime arrival_time
        numeric base_fare "economy fare"
        enum status "SCHEDULED | BOARDING | DEPARTED | ARRIVED | DELAYED | CANCELLED"
        string boarding_gate
    }

    BOOKING ||--o| BOARDING_PASS : "generates"
    BOOKING ||--o| CHECKIN : "has"
    BOOKING ||--o{ BAGGAGE : "carries"
    BOOKING {
        int id PK
        string booking_reference UK
        int passenger_id FK
        int flight_id FK
        int seat_id FK
        numeric fare_amount
        numeric refund_amount
        enum status "UNPAID | CONFIRMED | CHECKED_IN | COMPLETED | CANCELLED | REFUND_REQUESTED | REFUNDED"
        datetime booked_at
        datetime cancelled_at
    }

    STAFF ||--o{ FLIGHT_STAFF : "assigned to"
    FLIGHT_STAFF {
        int id PK
        int flight_id FK
        int staff_id FK
        enum role "PILOT | CABIN_CREW"
    }

    CHECKIN ||--o| BOARDING_PASS : "issues"
    CHECKIN {
        int id PK
        int booking_id FK "UK"
        datetime checked_in_at
        int checked_in_by_staff_id FK
    }

    BOARDING_PASS {
        int id PK
        int booking_id FK "UK"
        int checkin_id FK "UK"
        string boarding_pass_number UK
        string boarding_gate
        string boarding_group
        datetime issued_at
    }

    BAGGAGE {
        int id PK
        int booking_id FK
        string bag_tag UK
        numeric weight_kg
        datetime created_at
    }